PORT=5000
MONGO_URL=mongodb://localhost:27017
MONGO_DB=stockdata
MONGO_COLLECTION=STOCKS

# Comma-separated allowed origins; leave empty to allow any origin
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional regex for preview deployments, e.g. ^https://dhanmantri(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# trace | debug | info | warn | error
LOG_LEVEL=info
# true = human-readable logs (defaults to true in a terminal)
LOG_PRETTY=
# Log every outgoing MongoDB command with its latency
LOG_DB_COMMANDS=true
CACHE_MAX_AGE=300
