PORT=5000
MONGO_URL=mongodb://localhost:27017
MONGO_DB=stockdata
MONGO_COLLECTION=STOCKS

# Comma-separated allowed origins (defaults to the deployed frontends + localhost)
# CORS_ORIGINS=https://dhanmantri-app.vercel.app,http://localhost:5173
# Regex for Vercel preview deployments (this is the default)
# CORS_ORIGIN_REGEX=^https://dhanmantri-[a-z0-9-]*shubhabha\.vercel\.app$

# trace | debug | info | warn | error
LOG_LEVEL=info
# true = human-readable logs (defaults to true in a terminal)
LOG_PRETTY=
# Log every outgoing MongoDB command with its latency
LOG_DB_COMMANDS=true
CACHE_MAX_AGE=300
# Stock API requests per minute per IP
RATE_LIMIT_PER_MINUTE=300
