# Backend API (defaults to http://localhost:5000 in dev)
VITE_API_URL=http://localhost:5000
# Public site URL used for canonical/OG links
VITE_SITE_URL=https://dhanmantri-shubhabha.vercel.app
# Set to false to silence request/response logging in the browser console
VITE_LOG_REQUESTS=true

# Finnhub API key for the market news panel (panel hides when empty)
VITE_FINNHUB_API_KEY=

# Firebase web config for Google sign-in (sign-in is disabled when empty)
VITE_FIREBASE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
